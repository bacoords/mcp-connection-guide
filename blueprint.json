{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "wp": "7.1",
    "php": "8.3"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "landingPage": "/wp-admin/options-connectors.php",
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/bacoords/mcp-connection-guide",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "mcp-connection-guide"
      }
    }
  ]
}
